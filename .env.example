ANTHROPIC_API_KEY=sk-ant-...
ADMIN_PASSWORD=senha-do-admin-aqui
SESSION_SECRET=string-aleatoria-longa-aqui
PORT=3000

# Opcional — API oficial de afiliados da Shopee (Shopee Affiliate Open Platform).
# Solicite em https://affiliate.shopee.com.br/open_api (Central de Ajuda > E-mail).
# Se não configurado, o bot usa scraping via navegador headless como alternativa.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Usadas apenas pelo serviço Caddy (docker-compose.yml) no deploy via VPS —
# obrigatórias para o proxy reverso subir com HTTPS. Ver DEPLOY.md.
DOMAIN=seu-dominio.com
LETSENCRYPT_EMAIL=seu-email@dominio.com

# --- Evolution API (docker-compose.yml) ---
# Infraestrutura para uma futura migração de whatsapp-web.js para a Evolution
# API. Ainda não é usada pelo bot — apenas sobe isolada para validação.

# Credenciais do Postgres usado pela Evolution API para persistir instâncias,
# sessões e mensagens. Container postgres não expõe porta pro host; só é
# acessível pelos outros serviços do compose.
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-por-uma-senha-forte-aqui
POSTGRES_DB=evolution

# Chave de autenticação da própria Evolution API — enviada no header
# `apikey` em toda chamada à API. Gere uma string aleatória longa, ex:
# openssl rand -hex 32
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria-longa-aqui
